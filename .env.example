# Neon Database Connections
# Pooled connection string (used by Next.js application runtime)
DATABASE_URL="postgresql://neondb_owner:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Direct / Unpooled connection string (used for running Drizzle migrations & DDL)
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Authentication secret (used for signing JWT session tokens)
# Generate a secure key with: openssl rand -base64 32
AUTH_SECRET="change-this-to-a-secure-random-secret-key-at-least-32-chars-long"

# Application Timezone
APP_TIMEZONE="Asia/Kolkata"

# Email Configuration
EMAIL_FROM="Guild Club Services <noreply@guildclubservices.com>"
RESEND_API_KEY="re_sample_123456789"

# Initial Super Admin Seed Credentials (used by `npm run db:seed`)
SUPER_ADMIN_NAME="Guild Super Admin"
SUPER_ADMIN_EMAIL="superadmin@guildclub.com"
SUPER_ADMIN_PASSWORD="ChangeMe@12345"
SUPER_ADMIN_PHONE="+91 9876543210"

# Vercel Blob File Storage (Private session photos and patient signatures)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_sample_token"
